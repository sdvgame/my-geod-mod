{
    "geode": "5.0.0",
    "gd": {
        "win": "2.2081",
        "android": "2.2081"
    },
    "id": "froge54.trail-tracker",
    "name": "Trail Tracker",
    "version": "v1.0.0",
    "developer": "froge54",
    "description": "Shows jump indicators and a movement trail in the editor and in normal gameplay.",
    "resources": {
        "sprites": [
            "resources/tracker-icon.png"
        ]
    },
    "settings": {
        "circle-color": {
            "type": "color",
            "name": "Jump Indicator Color",
            "default": [255, 255, 255]
        },
        "circle-size": {
            "type": "float",
            "name": "Jump Indicator Size",
            "default": 12.0,
            "min": 4.0,
            "max": 40.0
        },
        "outline-enabled": {
            "type": "bool",
            "name": "Enable Outline",
            "default": true
        },
        "outline-color": {
            "type": "color",
            "name": "Outline Color",
            "default": [0, 0, 0]
        },
        "y-offset": {
            "type": "float",
            "name": "Trail Y Offset (from player)",
            "default": 0.0,
            "min": -10.0,
            "max": 10.0
        },
        "trail-color": {
            "type": "color",
            "name": "Trail Line Color",
            "default": [0, 255, 0]
        },
        "trail-thickness": {
            "type": "float",
            "name": "Trail Line Thickness",
            "default": 2.0,
            "min": 0.5,
            "max": 10.0
        },
        "show-in-level": {
            "type": "bool",
            "name": "Show Trail in Normal Gameplay",
            "default": false
        },
        "show-jumps-in-level": {
            "type": "bool",
            "name": "Show Jumps in Normal Gameplay",
            "default": false
        }
    }
}